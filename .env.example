# ============================================================
#  Bolão da Copa 2026 — variáveis de ambiente
#  Copie para .env e preencha. NUNCA versione o .env real.
# ============================================================

# --- Banco de dados (Supabase PostgreSQL) -------------------
# Use o CONNECTION POOLER (transaction mode, porta 6543) para serverless.
# Supabase Dashboard → Project Settings → Database → Connection string → "Transaction".
# Troque [YOUR-PASSWORD] e [PROJECT-REF] pelos seus valores.
# Importante: o driver é psycopg2 → prefixo postgresql+psycopg2://
DATABASE_URL=postgresql+psycopg2://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Em desenvolvimento local você pode usar SQLite (sem Supabase):
# DATABASE_URL=sqlite:///./bolao_dev.db

# --- Segurança ----------------------------------------------
# Gere uma chave forte, ex.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-secreta-bem-grande
JWT_EXPIRE_MINUTES=10080   # 7 dias

# --- Bootstrap do admin -------------------------------------
# Ao se cadastrar com este email, o usuário vira administrador.
ADMIN_EMAIL=seu-email@exemplo.com

# --- Ambiente -----------------------------------------------
# "production" ativa cookies Secure (HTTPS). Em dev deixe "development".
ENVIRONMENT=development
